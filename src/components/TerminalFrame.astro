---
interface Props {
  title?: string;
  class?: string;
}

const { title = 'terminal', class: className = '' } = Astro.props;
---

<div class:list={['bg-bg border border-border rounded-[12px] max-w-[960px] w-full relative overflow-hidden', className]}>
  <div class="h-10 bg-[rgba(255,255,255,0.03)] border-b border-border flex items-center px-4 gap-2 font-mono text-xs text-dim">
    <span class="w-2.5 h-2.5 rounded-full bg-[#3b3b3f] inline-block"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#3b3b3f] inline-block"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-[#3b3b3f] inline-block"></span>
    <span class="ml-2 text-dim">{title}</span>
  </div>
  <div class="p-6">
    <slot />
  </div>
</div>

---
import Layout from '../../layouts/Layout.astro';
import TerminalFrame from '../../components/TerminalFrame.astro';
import StatusBar from '../../components/StatusBar.astro';
import SvgHeroBg from '../../components/SvgHeroBg.astro';
import SvgCtaBg from '../../components/SvgCtaBg.astro';
import { useCases } from '../../data/use-cases';
import '../../styles/global.css';

export function getStaticPaths() {
  return useCases.map((uc) => ({
    params: { slug: uc.slug },
    props: { useCase: uc },
  }));
}

const { useCase } = Astro.props;
---

<Layout title={`${useCase.title} — Agent Vision`} description={useCase.metaDescription} canonicalPath={`/cases/${useCase.slug}`}>

<!-- ═══ HEADER NAV ═══ -->
<nav class="max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-4 border-b border-border font-mono text-xs text-dim flex items-center gap-2">
  <a href="/" class="text-dim no-underline hover:text-amber transition-colors">agent-vision</a>
  <span>/</span>
  <a href="/#use-cases" class="text-dim no-underline hover:text-amber transition-colors">cases</a>
  <span>/</span>
  <span class="text-text-muted">{useCase.slug}</span>
</nav>

<!-- ═══ HERO ═══ -->
<div class="scannable max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] pt-20 pb-16 relative overflow-hidden" data-scan-id="case-hero">
  <div class="scan-line"></div>
  <SvgHeroBg />

  <div class="relative z-[1]">
    <h1 class="font-display text-[clamp(28px,4vw,52px)] font-bold text-text leading-[1.1] mb-6 max-w-[800px]">
      {useCase.headline}
    </h1>

    <p class="text-lg text-text-muted max-w-[640px] leading-relaxed">
      {useCase.intro}
    </p>
  </div>
</div>

<!-- ═══ BEFORE / AFTER ═══ -->
<div class="section-divider"></div>
<section class="scannable max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-20" data-scan-id="before-after">
  <div class="scan-line"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[1000px]">
    <div class="bg-surface border border-border rounded-[12px] p-8">
      <h2 class="font-mono text-[11px] text-dim mb-4 uppercase tracking-[2px]">{useCase.beforeTitle}</h2>
      <p class="text-text-muted leading-relaxed">{useCase.beforeText}</p>
    </div>
    <div class="bg-surface border border-[rgba(99,102,241,0.2)] rounded-[12px] p-8">
      <h2 class="font-mono text-[11px] text-indigo mb-4 uppercase tracking-[2px]">{useCase.afterTitle}</h2>
      <p class="text-text-muted leading-relaxed">{useCase.afterText}</p>
    </div>
  </div>
</section>

<!-- ═══ CLI COMMANDS ═══ -->
<div class="section-divider"></div>
<section class="scannable max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-20" data-scan-id="commands">
  <div class="scan-line"></div>

  <div class="section-label">Commands</div>
  <h2 class="font-display text-[clamp(24px,3vw,36px)] font-bold text-text mb-10 leading-[1.1]">
    How it works
  </h2>

  <div class="space-y-4 max-w-[800px]">
    {useCase.commands.map((command) => (
      <div>
        <p class="font-mono text-xs text-dim mb-2">{command.label}</p>
        <TerminalFrame title="terminal" class="!max-w-full">
          <div class="font-mono text-sm">
            <span class="text-dim">$ </span><span class="text-text">{command.cmd}</span>
          </div>
          <p class="text-xs text-text-muted mt-3">{command.description}</p>
        </TerminalFrame>
      </div>
    ))}
  </div>
</section>

<!-- ═══ SCENARIO ═══ -->
<div class="section-divider"></div>
<section class="scannable max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-20" data-scan-id="scenario">
  <div class="scan-line"></div>

  <div class="section-label">Real scenario</div>
  <h2 class="font-display text-[clamp(24px,3vw,36px)] font-bold text-text mb-10 leading-[1.1]">
    {useCase.scenario.title}
  </h2>

  <TerminalFrame title="workflow" class="max-w-[800px]">
    <div class="-m-6">
      {useCase.scenario.steps.map((step, i) => (
        <div class:list={['grid grid-cols-[40px_1fr] text-[13px]', i < useCase.scenario.steps.length - 1 && 'border-b border-border']}>
          <div class="p-4 text-dim text-center font-mono">{String(i + 1).padStart(2, '0')}</div>
          <div class="p-4 text-text-muted text-sm">{step}</div>
        </div>
      ))}
    </div>
  </TerminalFrame>
</section>

<!-- ═══ CTA ═══ -->
<div class="section-divider"></div>
<section class="scannable text-center py-24 px-6 flex flex-col items-center relative overflow-hidden" data-scan-id="case-cta">
  <div class="scan-line"></div>
  <SvgCtaBg />

  <div class="relative z-[1]">
    <h2 class="font-display text-[clamp(20px,3vw,32px)] font-bold text-text mb-4">
      Try it now
    </h2>

    <TerminalFrame title="terminal">
      <div class="text-center py-4 px-8">
        <div class="font-mono text-[clamp(14px,1.8vw,20px)] text-text space-y-1">
          <div><span class="text-dim">$ </span>brew tap rvanbaalen/agent-vision</div>
          <div><span class="text-dim">$ </span>brew install agent-vision</div>
        </div>
      </div>
    </TerminalFrame>

    <p class="text-[13px] text-dim mt-5">
      Requires macOS 13+ · No dependencies · ~4MB
    </p>

    <a href="/" class="mt-8 text-[13px] text-amber no-underline hover:text-amber-light transition-colors">
      &larr; Back to agentvision.robinvanbaalen.nl
    </a>
  </div>
</section>

<!-- ═══ FOOTER ═══ -->
<footer class="border-t border-border max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-8 pb-16 text-[13px] text-dim flex justify-between items-center">
  <span>Agent Vision · Built for macOS · Made by <a href="https://robinvanbaalen.nl" class="text-dim no-underline hover:text-amber transition-colors">Robin</a></span>
  <span>
    <a href="#" class="text-dim no-underline hover:text-amber transition-colors">GitHub</a>
    <span class="mx-1">·</span>
    <a href="#" class="text-dim no-underline hover:text-amber transition-colors">Docs</a>
  </span>
</footer>

<StatusBar />

<script src="../../scripts/overlay.ts"></script>

</Layout>

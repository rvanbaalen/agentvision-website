---
import Layout from '../layouts/Layout.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import SvgHeroBg from '../components/SvgHeroBg.astro';
import SvgSectionBg from '../components/SvgSectionBg.astro';
import SvgCtaBg from '../components/SvgCtaBg.astro';
import { useCases } from '../data/use-cases';
import '../styles/global.css';
---

<Layout title="Agent Vision — Your AI agent can't see. Fix that.">

<!-- ═══ HERO ═══ -->
<div class="scannable min-h-screen flex flex-col justify-center max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] pb-16" data-scan-id="hero">
  <div class="scan-line"></div>
  <SvgHeroBg />

  <div class="relative z-[1]">
    <span class="inline-block font-mono text-[11px] text-amber bg-[rgba(245,158,11,0.1)] border border-[rgba(245,158,11,0.2)] rounded-[6px] px-2.5 py-0.5 mb-6">macOS native</span>

    <h1 class="font-display text-[clamp(40px,6vw,72px)] font-black leading-[1.05] mb-6 max-w-[700px] bg-gradient-to-br from-text to-indigo-light bg-clip-text text-transparent">
      Your AI agent can't see. Fix that.
    </h1>

    <p class="text-xl text-text-muted max-w-[520px] mb-10 leading-relaxed">
      Agent Vision gives AI agents eyes and hands on your Mac. Screenshot, discover UI elements, click, type, scroll. Any app, any window.
    </p>

    <div class="install-block group relative inline-flex items-start gap-4 bg-surface border border-border rounded-lg px-6 py-3.5 font-mono text-[15px] mb-4 hover:border-amber hover:shadow-[0_0_20px_rgba(245,158,11,0.08)] transition-all duration-200">
      <div class="text-left space-y-0.5">
        <div><span class="text-dim">$ </span><span class="text-text">brew install rvanbaalen/tap/agent-vision</span></div>
      </div>
      <button type="button" class="copy-btn shrink-0 mt-0.5 text-dim hover:text-amber transition-colors" aria-label="Copy install commands">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/><path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
    </div>

    <p class="text-[13px] text-dim mt-2">
      Works with <span class="text-amber-light">Claude Code</span>, <span class="text-amber-light">Codex</span>, <span class="text-amber-light">Gemini CLI</span>
    </p>
  </div>
</div>

<!-- ═══ GET STARTED IN 30 SECONDS ═══ -->
<div class="section-divider"></div>
<div class="bg-surface relative overflow-hidden">
  <SvgSectionBg />
  <section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] relative z-[1]">

    <div class="section-label">Get started</div>
    <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-16 leading-[1.1]">
      Up and running in 30 seconds
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-bg border border-border rounded-[12px] p-7 relative">
        <span class="absolute top-4 right-5 font-display text-5xl font-black text-[rgba(99,102,241,0.1)] leading-none">1</span>
        <h3 class="font-display text-lg font-semibold text-text mb-3">Install</h3>
        <TerminalFrame title="terminal" class="!max-w-full">
          <div class="font-mono text-[13px] space-y-0.5">
            <div><span class="text-dim">$ </span><span class="text-text">brew install rvanbaalen/tap/agent-vision</span></div>
          </div>
        </TerminalFrame>
      </div>

      <div class="bg-bg border border-border rounded-[12px] p-7 relative">
        <span class="absolute top-4 right-5 font-display text-5xl font-black text-[rgba(99,102,241,0.1)] leading-none">2</span>
        <h3 class="font-display text-lg font-semibold text-text mb-3">Teach your agent</h3>
        <TerminalFrame title="terminal" class="!max-w-full">
          <div class="font-mono text-[13px]">
            <div><span class="text-dim">$ </span><span class="text-text">agent-vision learn</span></div>
          </div>
        </TerminalFrame>
        <p class="text-sm text-text-muted mt-3">Outputs the full command reference. Your AI agent now knows every command.</p>
      </div>

      <div class="bg-bg border border-border rounded-[12px] p-7 relative">
        <span class="absolute top-4 right-5 font-display text-5xl font-black text-[rgba(99,102,241,0.1)] leading-none">3</span>
        <h3 class="font-display text-lg font-semibold text-text mb-3">Give it a task</h3>
        <div class="bg-[rgba(99,102,241,0.05)] border border-[rgba(99,102,241,0.15)] rounded-lg px-4 py-3 text-sm text-text-muted italic leading-relaxed">
          "Use agent-vision to capture all states of the iOS Simulator, dark mode and light mode"
        </div>
        <p class="text-sm text-text-muted mt-3">Just describe what you want in plain English. That's it.</p>
      </div>
    </div>
  </section>
</div>

<!-- ═══ WHAT YOU CAN TELL YOUR AGENT ═══ -->
<div class="section-divider"></div>
<section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)]">

  <div class="section-label">Example prompts</div>
  <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
    What you can tell your agent
  </h2>

  <div class="space-y-4 max-w-[800px]">
    {[
      { prompt: 'Use agent-vision to screenshot the app in dark mode and light mode on the simulator', tag: 'Visual QA', href: '/cases/mobile-simulator-testing' },
      { prompt: 'Use agent-vision to fill out the signup form and capture each step', tag: 'Form testing', href: '/cases/form-automation' },
      { prompt: 'Use agent-vision to navigate to Settings > Privacy and check what\'s enabled', tag: 'App navigation', href: '/cases/qa-testing' },
      { prompt: 'Use agent-vision to QA test the login flow across Safari, Chrome, and Firefox', tag: 'Cross-browser', href: '/cases/web-app-automation' },
      { prompt: 'Use agent-vision to control the other Claude session and build this feature', tag: 'AI orchestration', href: '/cases/ai-controlling-ai' },
    ].map(example => (
      <a href={example.href} class="block bg-surface border border-border rounded-[12px] px-6 py-5 group hover:border-amber hover:shadow-[0_4px_24px_rgba(245,158,11,0.06)] transition-all duration-200 no-underline">
        <div class="flex items-start justify-between gap-4">
          <p class="text-text leading-relaxed italic">"{example.prompt}"</p>
          <span class="shrink-0 font-mono text-[11px] text-indigo bg-[rgba(99,102,241,0.08)] border border-[rgba(99,102,241,0.15)] rounded-[6px] px-2.5 py-0.5 mt-0.5">{example.tag}</span>
        </div>
        <span class="text-[13px] text-amber mt-2 block group-hover:text-amber-light transition-colors">See use case &rarr;</span>
      </a>
    ))}
  </div>
</section>

<!-- ═══ HOW IT SEES ═══ -->
<div class="section-divider"></div>
<section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)]">

  <div class="section-label">How it sees</div>
  <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
    Native macOS APIs. Not browser hacks.
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
    <div>
      <p class="mb-4 text-text-muted max-w-[480px]">
        <strong class="text-text">Accessibility API + Vision OCR.</strong> Agent Vision uses macOS native APIs to discover every interactive element on screen. Buttons, text fields, links, labels.
      </p>
      <p class="mb-4 text-text-muted max-w-[480px]">
        No DOM. No browser. No Puppeteer. It reads what macOS already knows about every app's UI, then maps those elements to screen coordinates your AI agent can act on.
      </p>
      <p class="text-text-muted max-w-[480px]">
        Works with <strong class="text-text">any macOS application</strong>. Xcode, Figma, Mail, Terminal, your custom Electron app — if it's on screen, Agent Vision can see it.
      </p>
    </div>

    <TerminalFrame title="agent-vision elements">
      <div class="space-y-0">
        {[
          { type: 'button', id: 'el-btn-001', label: '"Submit Form"' },
          { type: 'textfield', id: 'el-input-002', label: '"Enter email"' },
          { type: 'link', id: 'el-link-003', label: '"Documentation"' },
          { type: 'heading', id: 'el-heading-004', label: '"Account Settings"' },
          { type: 'image', id: 'el-img-005', label: '"User avatar"' },
        ].map((el, i, arr) => (
          <div class:list={['flex gap-3 py-1.5 font-mono text-xs', i < arr.length - 1 && 'border-b border-border']}>
            <span class="text-indigo-light min-w-[80px]">{el.type}</span>
            <span class="text-dim min-w-[110px]">{el.id}</span>
            <span class="text-text-muted">{el.label}</span>
          </div>
        ))}
      </div>
    </TerminalFrame>
  </div>
</section>

<!-- ═══ THE LOOP ═══ -->
<div class="section-divider"></div>
<div class="bg-surface relative overflow-hidden">
  <SvgSectionBg side="left" />
  <section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] relative z-[1]">

    <div class="section-label">The loop</div>
    <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
      Scan. Act. Re-scan.
    </h2>

    <div class="flex gap-0.5 overflow-x-auto">
      {[
        { num: '1', name: 'start', desc: 'Select a screen region.', cmd: 'agent-vision start --region 0,0,1440,900' },
        { num: '2', name: 'capture', desc: 'Screenshot the region.', cmd: 'agent-vision capture --session $SID' },
        { num: '3', name: 'elements', desc: 'Discover every UI element.', cmd: 'agent-vision elements --session $SID' },
        { num: '4', name: 'control', desc: 'Click, type, scroll.', cmd: 'agent-vision click --element el-btn-001' },
        { num: '5', name: 're-scan', desc: 'Screen changed. Loop.', cmd: 'agent-vision capture --session $SID' },
      ].map(step => (
        <div class="flex-1 min-w-[180px] bg-bg border border-border rounded-[12px] p-6 relative">
          <span class="absolute top-3 right-4 font-display text-5xl font-black text-[rgba(99,102,241,0.1)] leading-none">{step.num}</span>
          <h3 class="font-display text-base font-semibold text-text mb-2">{step.name}</h3>
          <p class="text-[13px] text-text-muted mb-3">{step.desc}</p>
          <code class="block font-mono text-[11px] text-dim bg-[rgba(255,255,255,0.03)] rounded p-2">{step.cmd}</code>
        </div>
      ))}
    </div>
  </section>
</div>

<!-- ═══ WHY NOT PUPPETEER ═══ -->
<div class="section-divider"></div>
<section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)]">

  <div class="section-label">Comparison</div>
  <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
    Why not Puppeteer?
  </h2>

  <TerminalFrame title="comparison" class="max-w-[800px]">
    <div class="-m-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="text-left p-4 font-mono text-xs text-dim font-normal uppercase tracking-wider">Capability</th>
            <th class="text-center p-4 font-mono text-xs text-indigo font-normal uppercase tracking-wider">Agent Vision</th>
            <th class="text-center p-4 font-mono text-xs text-dim font-normal uppercase tracking-wider">Puppeteer</th>
            <th class="text-center p-4 font-mono text-xs text-dim font-normal uppercase tracking-wider">AppleScript</th>
          </tr>
        </thead>
        <tbody>
          {[
            { cap: 'Any macOS app', av: '✓', pp: '—', as: '~' },
            { cap: 'Native UI element discovery', av: '✓', pp: '—', as: '~' },
            { cap: 'Screenshot + OCR', av: '✓', pp: '✓', as: '—' },
            { cap: 'Focus-free interaction', av: '✓', pp: '—', as: '—' },
            { cap: 'Works without browser', av: '✓', pp: '—', as: '✓' },
            { cap: 'Coordinate-accurate clicks', av: '✓', pp: '✓', as: '—' },
            { cap: 'Session-based', av: '✓', pp: '✓', as: '—' },
          ].map((row, i, arr) => (
            <tr class:list={[i < arr.length - 1 && 'border-b border-border']}>
              <td class="p-4 text-text-muted">{row.cap}</td>
              <td class="p-4 text-center text-indigo-light">{row.av}</td>
              <td class="p-4 text-center text-dim">{row.pp}</td>
              <td class="p-4 text-center text-dim">{row.as}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </TerminalFrame>

  <p class="text-sm text-text-muted mt-6 max-w-[600px]">
    Puppeteer and Playwright only work in browsers. AppleScript works with some native apps but can't discover elements reliably or interact with coordinates. Agent Vision does both — for every app on your Mac.
  </p>
</section>

<!-- ═══ WORKS WITH ═══ -->
<div class="section-divider"></div>
<div class="bg-surface relative overflow-hidden">
  <SvgSectionBg />
  <section class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] relative z-[1]">

    <div class="section-label">Integrations</div>
    <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
      Works with your agent
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h3 class="font-display text-base font-semibold text-text mb-4">Claude Code</h3>
        <TerminalFrame title="terminal" class="!max-w-full">
          <div class="font-mono text-[13px] space-y-0.5">
            <div class="text-dim text-[11px] mb-1"># add the skill marketplace</div>
            <div><span class="text-dim">$ </span><span class="text-text">claude plugin marketplace add rvanbaalen/skills</span></div>
            <div class="text-dim text-[11px] mt-2 mb-1"># install the skill</div>
            <div><span class="text-dim">$ </span><span class="text-text">claude plugin install use-agentvision</span></div>
          </div>
        </TerminalFrame>
        <p class="text-xs text-text-muted mt-3">
          Install the skill and Claude automatically knows every command, workflow, and best practice for agent-vision.
        </p>
      </div>

      <div>
        <h3 class="font-display text-base font-semibold text-text mb-4">Codex</h3>
        <TerminalFrame title="codex session" class="!max-w-full">
          <pre class="font-mono text-xs text-text-muted leading-relaxed"><span class="text-dim">$</span> <span class="text-text">codex</span>
<span class="text-dim">&gt;</span> Use agent-vision to check
  the login form in Simulator</pre>
        </TerminalFrame>
        <p class="text-xs text-text-muted mt-3">
          Any agent that can run shell commands can use Agent Vision. No special integration needed.
        </p>
      </div>

      <div>
        <h3 class="font-display text-base font-semibold text-text mb-4">Gemini CLI</h3>
        <TerminalFrame title="gemini session" class="!max-w-full">
          <pre class="font-mono text-xs text-text-muted leading-relaxed"><span class="text-dim">$</span> <span class="text-text">gemini</span>
<span class="text-dim">&gt;</span> Screenshot the Figma canvas
  and list all text elements</pre>
        </TerminalFrame>
        <p class="text-xs text-text-muted mt-3">
          Works the same way. Start a session, capture, discover, act. The interface is the CLI.
        </p>
      </div>
    </div>
  </section>
</div>

<!-- ═══ MORE USE CASES ═══ -->
<div class="section-divider"></div>
<section id="use-cases" class="py-[120px] max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)]">

  <div class="section-label">Deep dives</div>
  <h2 class="font-display text-[clamp(28px,4vw,44px)] font-bold text-text mb-12 leading-[1.1]">
    Explore use cases
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {useCases.map(uc => (
      <a href={`/cases/${uc.slug}`} class="bg-surface border border-border rounded-[12px] p-7 no-underline block group hover:border-amber hover:shadow-[0_4px_24px_rgba(245,158,11,0.06)] hover:-translate-y-0.5 transition-all duration-200">
        <h3 class="font-display text-lg font-semibold text-text mb-2 group-hover:text-text transition-colors">{uc.title}</h3>
        <p class="text-sm text-text-muted mb-4 leading-relaxed">{uc.cardDescription}</p>
        <span class="text-[13px] text-amber group-hover:text-amber-light transition-colors">Read more &rarr;</span>
      </a>
    ))}
  </div>
</section>

<!-- ═══ RESEARCH PREVIEW WARNING ═══ -->
<section class="max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-16">
  <div class="bg-[rgba(245,158,11,0.05)] border border-[rgba(245,158,11,0.2)] rounded-[12px] p-8 max-w-[800px] mx-auto">
    <div class="flex items-start gap-4">
      <svg class="shrink-0 mt-0.5 text-amber" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <h3 class="font-display text-lg font-semibold text-amber mb-2">Research Preview</h3>
        <p class="text-text-muted leading-relaxed text-[15px]">
          Agent Vision is a research preview. It is not safe for use in any production environment. It is meant as a productivity assistance tool. While some guardrails exist, it is not safe to run unsupervised. Use at your own risk.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ FOOTER ═══ -->
<footer class="border-t border-border max-w-[1200px] mx-auto px-[clamp(24px,5vw,120px)] py-8 pb-16 text-[13px] text-dim flex justify-between items-center">
  <span>Agent Vision · Built for macOS · Made by <a href="https://robinvanbaalen.nl" class="text-dim no-underline hover:text-amber transition-colors">Robin</a></span>
  <span>
    <a href="#" class="text-dim no-underline hover:text-amber transition-colors">GitHub</a>
    <span class="mx-1">·</span>
    <a href="#" class="text-dim no-underline hover:text-amber transition-colors">Docs</a>
  </span>
</footer>

<script src="../scripts/overlay.ts"></script>
<script>
document.querySelectorAll('.copy-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    navigator.clipboard.writeText('brew install rvanbaalen/tap/agent-vision');
    const svg = btn.querySelector('svg');
    if (!svg) return;
    const orig = svg.outerHTML;
    svg.outerHTML = '<svg width="' + svg.getAttribute('width') + '" height="' + svg.getAttribute('height') + '" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3 3 7-7" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    setTimeout(() => { btn.querySelector('svg')!.outerHTML = orig; }, 1500);
  });
});
</script>

</Layout>
